# Build output
/bin/
/dist/
/apptrol
/THIRD_PARTY_LICENSES

# Go
*.test
*.out
coverage.*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Worktrees that agents make by hand (git worktree add), named after no tool
.worktrees/

# Personal Claude Code settings, and worktrees made by Claude Code's own tools
.claude/settings.local.json
.claude/worktrees/

# Codex skills that T3 Code copies from .claude/commands/ into each checkout
# (source-command-<name>). The real shared skills live in .agents/skills/<name>/; an
# untracked copy stopped agents at `git status` and kept T3 from cleaning up worktrees.
/.agents/skills/source-command-*/
